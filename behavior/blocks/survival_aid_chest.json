{
  "format_version": "1.21.20",
  "minecraft:block": {
    "description": {
      "identifier": "simplexidev:survival_aid_chest",
      "menu_category": {
        "category": "items"
      },
      "states": {
        "simplexidev:has_reward": [false, true],
