      },
      "simplexidev:survival_aid_chest_component": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('simplexidev:has_reward') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "survival_aid_chest_alt",
              "render_method": "opaque"
            }
          }
        }
      },
      {
        "condition": "q.block_state('simplexidev:is_open') == true",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "survival_aid_chest",
              "render_method": "opaque"
            }
          }
        }
      }
    ]
  }
}
