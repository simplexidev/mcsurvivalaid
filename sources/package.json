{
  "name": "survival_aid",
  "version": "0.1.0",
  "productName": "Survival Aid Minecraft Bedrock Add-On",
  "description": "Survival Aid Minecraft Bedrock Add-On",
  "private": true,
  "dependencies": {
    "@minecraft/math": "^2.4.0",
    "@minecraft/server": "^2.7.0",
    "@minecraft/server-ui": "^2.0.0",
    "@minecraft/vanilla-data": "^1.26.20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint-plugin-minecraft-linting": "^2.0.12",
    "typescript": "^6.0.3",
    "ts-node": "^10.9.2",
    "source-map": "^0.7.6",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');const path=require('path');const root='behaviors/scripts';const exts=new Set(['.js','.js.map','.d.ts']);const walk=(d)=>{if(!fs.existsSync(d))return;for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())walk(p);else if(exts.has(e.name.endsWith('.d.ts')?'.d.ts':path.extname(e.name)))fs.rmSync(p,{force:true});}};walk(root);\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild": "npm run clean && npm run build",
    "lint": "eslint scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy-local": "deploy.cmd",
    "mcaddon": "just-scripts mcaddon",
    "enablemcloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
    "enablemcpreviewloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476",
    "lint:fix": "eslint scripts --fix"
  }
}
