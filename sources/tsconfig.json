{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "scripts",
    "outDir": "behaviors/scripts",
    "strict": false,
    "noImplicitAny": false,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "behaviors/scripts/**", "behaviors/**/*.json", "resources/**"]
}
